{
    "manifest_version": 3,
    "name": "LocalStorage Key 讀取器",
    "version": "1.0.0",
    "description": "讀取當前網頁自訂 LocalStorage Key 的 Value",
    "permissions": ["activeTab", "scripting", "storage"],
    "action": {
        "default_popup": "popup.html"
    },
    "content_scripts": [
        {
            "matches": ["<all_urls>"],
            "js": ["content.js"]
        }
    ]
}
