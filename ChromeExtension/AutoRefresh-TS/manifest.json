{
    "manifest_version": 3,
    "name": "網頁自動刷新器 - Auto Refresh",
    "version": "1.0.0",
    "description": "提供自訂秒數自動刷新網頁、即時倒數計時、網頁懸浮小工具與防快取重新整理",
    "permissions": ["storage", "tabs", "alarms"],
    "host_permissions": ["http://*/*", "https://*/*"],
    "action": {
        "default_popup": "popup.html"
    },
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches": ["http://*/*", "https://*/*"],
            "js": ["content.js"],
            "run_at": "document_idle"
        }
    ]
}
