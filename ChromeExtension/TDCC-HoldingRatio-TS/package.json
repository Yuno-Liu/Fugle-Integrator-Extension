{
    "name": "tdcc-holdingratio-ts",
    "version": "1.0.0",
    "type": "module",
    "description": "TDCC 持股比例統計工具 - TypeScript 版本",
    "scripts": {
        "build": "esbuild src/content.ts --bundle --outfile=dist/content.js --format=iife --target=es2020 && npm run copy:assets",
        "copy:assets": "node -e \"const fs=require('fs'); fs.copyFileSync('manifest.json', 'dist/manifest.json');\"",
        "watch": "esbuild src/content.ts --bundle --outfile=dist/content.js --format=iife --target=es2020 --watch",
        "clean": "rimraf dist/*.js dist/*.js.map dist/*.json dist-test/**/*",
        "typecheck": "tsc --noEmit",
        "build:test": "tsc -p tsconfig.test.json",
        "test": "npm run build:test && node --test tests/*.test.mjs"
    },
    "devDependencies": {
        "@types/chrome": "^0.0.287",
        "esbuild": "^0.27.4",
        "rimraf": "^6.0.1",
        "typescript": "^5.7.2"
    },
    "keywords": [
        "chrome-extension",
        "tdcc",
        "typescript"
    ],
    "author": "",
    "license": "MIT"
}
