{
  "manifest_version": 3,
  "name": "Antigravity 網頁全站翻譯器 (CLI Translator)",
  "version": "1.0.0",
  "description": "使用 Antigravity CLI (預設 gemini-3.8-flash low) 進行全站雙語/替換網頁翻譯，提供豐富視覺、領域風格、術語表與自動化自訂設定。",
  "permissions": [
    "storage",
    "activeTab",
    "contextMenus",
    "scripting"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Antigravity 網頁翻譯器"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
