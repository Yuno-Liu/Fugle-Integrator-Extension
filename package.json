{
    "name": "fugle-integrator",
    "version": "2.1.0",
    "private": true,
    "type": "module",
    "description": "富果整合器",
    "engines": {
        "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
    },
    "scripts": {
        "build": "node scripts/build.mjs",
        "build:dev": "node scripts/build.mjs --dev",
        "watch": "node scripts/build.mjs --watch",
        "clean": "node -e \"for (const d of ['dist', '.test-dist']) require('node:fs').rmSync(d, { recursive: true, force: true })\"",
        "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
        "test": "node scripts/test.mjs",
        "check": "npm run typecheck && npm test && npm run build",
        "e2e": "node scripts/e2e.mjs"
    },
    "devDependencies": {
        "@types/chrome": "^0.0.287",
        "@types/jsdom": "^30.0.0",
        "@types/node": "^24.0.0",
        "esbuild": "^0.27.4",
        "jsdom": "^30.1.3",
        "playwright-core": "1.58.2",
        "typescript": "^5.7.2"
    },
    "keywords": [
        "chrome-extension",
        "fugle",
        "stock",
        "typescript"
    ],
    "author": "",
    "license": "MIT"
}
