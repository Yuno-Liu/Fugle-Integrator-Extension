{
    "manifest_version": 3,
    "name": "富果整合器 - Fugle Integrator",
    "version": "2.1.0",
    "description": "在富果個股頁整合產業鏈、主力與法人籌碼、機構評等、財務指標等外部資料，並提供分析網站快捷連結",
    "minimum_chrome_version": "116",
    "permissions": [
        "storage"
    ],
    "host_permissions": [
        "https://sjis.esunsec.com.tw/*",
        "https://www.fugle.tw/*",
        "https://api.finmindtrade.com/*",
        "https://www.findbillion.com/*"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "options_page": "options.html",
    "content_scripts": [
        {
            "matches": [
                "https://www.fugle.tw/*"
            ],
            "js": [
                "content.js"
            ],
            "run_at": "document_idle"
        }
    ]
}
